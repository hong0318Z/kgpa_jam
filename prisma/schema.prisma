// 한국게임정책학회(KGPA) 인터랙티브미디어저널 투고/심사 관리 시스템

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  AUTHOR
  REVIEWER
  EDITOR
  CHIEF_EDITOR
  ADMIN
}

enum VolumeStatus {
  OPEN
  CLOSED
  PUBLISHED
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUESTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ReviewRecommendation {
  ACCEPT
  MINOR_REVISION
  MAJOR_REVISION
  REJECT
}

enum ReviewStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  DECLINED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  affiliation  String?
  position     String?
  phone        String?
  role         Role     @default(AUTHOR)
  isActive     Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  profileComplete    Boolean   @default(true)
  privacyConsentAt   DateTime?
  isTestAccount      Boolean   @default(false)
  reviewerBankName          String?
  reviewerBankAccountNumber String?
  reviewerBankAccountHolder String?
  preferredFields           String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions       Submission[]       @relation("AuthorSubmissions")
  reviewAssignments ReviewAssignment[] @relation("ReviewerAssignments")
  decisionsMade     Decision[]         @relation("EditorDecisions")
  notices           Notice[]           @relation("NoticeAuthor")
  resourcesUploaded Resource[]         @relation("ResourceUploader")
  auditLogs         AuditLog[]         @relation("AuditActor")
  coauthorEntries   SubmissionAuthor[] @relation("SubmissionAuthorUser")
  policiesUpdated   Policy[]           @relation("PolicyUpdater")
  authorResponses   AuthorResponse[]   @relation("AuthorResponseAuthor")
  siteSettingsUpdated SiteSettings[]   @relation("SiteSettingsUpdater")
  feeSettingsUpdated  FeeSettings[]    @relation("FeeSettingsUpdater")
  emailTemplatesUpdated EmailTemplate[] @relation("EmailTemplateUpdater")
}

model Volume {
  id                 String       @id @default(cuid())
  label              String // 예: "Vol.15 No.2"
  callStartDate      DateTime // 공식 투고 모집 시작일
  callEndDate        DateTime // 공식 투고 모집 종료일
  plannedPublishDate DateTime // 발간예정일
  status             VolumeStatus @default(OPEN)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  submissions Submission[]
}

model Submission {
  id                 String           @id @default(cuid())
  caseNumber         Int              @unique @default(autoincrement())
  title              String
  abstract           String
  keywords           String[]
  pledgeAuthorNames  String?
  status             SubmissionStatus @default(SUBMITTED)
  round              Int              @default(1)
  isUrgent           Boolean          @default(false)
  fields             String[]         @default([])
  finalManuscriptSubmittedAt DateTime?
  authorId  String
  author    User             @relation("AuthorSubmissions", fields: [authorId], references: [id])
  volumeId  String
  volume    Volume           @relation(fields: [volumeId], references: [id])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  files           SubmissionFile[]
  assignments     ReviewAssignment[]
  decisions       Decision[]
  statusLogs      StatusLog[]
  coauthors       SubmissionAuthor[]
  authorResponses AuthorResponse[]
  revisionSnapshots SubmissionRevisionSnapshot[]
}

model SubmissionRevisionSnapshot {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  round        Int
  title        String
  abstract     String
  keywords     String[]
  fields       String[]
  decisionNote String?
  createdAt    DateTime   @default(now())
}

enum SubmissionFileKind {
  MAIN
  APPENDIX
  SIMILARITY_REPORT
  FINAL_MANUSCRIPT
  COPYRIGHT_ASSIGNMENT
}

model SubmissionFile {
  id           String             @id @default(cuid())
  submissionId String
  submission   Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  version      Int                @default(1)
  round        Int                @default(1)
  kind         SubmissionFileKind @default(MAIN)
  originalName String
  storedPath   String
  mimeType     String
  sizeBytes    Int
  uploadedAt   DateTime           @default(now())
}

model ReviewAssignment {
  id           String       @id @default(cuid())
  submissionId String
  submission   Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User         @relation("ReviewerAssignments", fields: [reviewerId], references: [id])
  round        Int          @default(1)
  status       ReviewStatus @default(ASSIGNED)
  assignedAt   DateTime     @default(now())
  dueDate      DateTime?
  review       Review?

  @@unique([submissionId, reviewerId, round])
}

model Review {
  id               String               @id @default(cuid())
  assignmentId     String               @unique
  assignment       ReviewAssignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  score            Int?
  commentsToAuthor String
  commentsToEditor String?
  recommendation   ReviewRecommendation
  submittedAt      DateTime             @default(now())
}

model Decision {
  id           String           @id @default(cuid())
  submissionId String
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  editorId     String
  editor       User             @relation("EditorDecisions", fields: [editorId], references: [id])
  outcome      SubmissionStatus
  note         String?
  decidedAt    DateTime         @default(now())
}

model StatusLog {
  id           String            @id @default(cuid())
  submissionId String
  submission   Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fromStatus   SubmissionStatus?
  toStatus     SubmissionStatus
  note         String?
  changedAt    DateTime          @default(now())
}

model Notice {
  id        String   @id @default(cuid())
  title     String
  content   String
  isPinned  Boolean  @default(false)
  authorId  String
  author    User     @relation("NoticeAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resource {
  id           String   @id @default(cuid())
  title        String
  description  String?
  originalName String
  storedPath   String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedBy   User     @relation("ResourceUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model SubmissionAuthor {
  id              String     @id @default(cuid())
  submissionId    String
  submission      Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?      @relation("SubmissionAuthorUser", fields: [userId], references: [id])
  name            String
  email           String
  affiliation     String
  isCorresponding Boolean    @default(false)
  order           Int
  createdAt       DateTime   @default(now())

  @@index([submissionId])
}

model AuthorResponse {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation("AuthorResponseAuthor", fields: [authorId], references: [id])
  content      String
  createdAt    DateTime   @default(now())

  @@index([submissionId])
}

model Policy {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  content       String
  effectiveDate DateTime?
  revisionDates DateTime[] @default([])
  updatedById   String?
  updatedBy     User?      @relation("PolicyUpdater", fields: [updatedById], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model SiteSettings {
  id              String   @id @default("singleton")
  maintenanceMode Boolean  @default(true)
  updatedAt       DateTime @updatedAt
  updatedById     String?
  updatedBy       User?    @relation("SiteSettingsUpdater", fields: [updatedById], references: [id])
}

model FeeSettings {
  id                           String   @id @default("singleton")
  bankName                     String?
  bankAccountNumber            String?
  bankAccountHolder            String?
  reviewPayoutPerReview        Int?
  authorReviewFeePerSubmission Int?
  publicationFeePerPage        Int?
  publicationFeeFlat           Int?
  urgentPublicationFeeExtra    Int?
  updatedAt                    DateTime @updatedAt
  updatedById                  String?
  updatedBy                    User?    @relation("FeeSettingsUpdater", fields: [updatedById], references: [id])
}

model EmailTemplate {
  key         String   @id
  subject     String
  bodyHtml    String
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("EmailTemplateUpdater", fields: [updatedById], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([targetType, targetId])
}
