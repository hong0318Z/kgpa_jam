# docker-compose.yml reads DB_PASSWORD / NEXTAUTH_SECRET / NEXTAUTH_URL from this file
# and builds DATABASE_URL itself (db user/db name are fixed to "kgpa" / "kgpa_jam" in compose).
DB_PASSWORD="CHANGE_ME"
NEXTAUTH_SECRET="CHANGE_ME_RANDOM_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth login (Google Cloud Console > APIs & Services > 사용자 인증 정보).
# Authorized redirect URI must be: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Outgoing mail via Brevo SMTP relay (k-gpa.or.kr domain authenticated with DKIM/DMARC
# in the Brevo dashboard). BREVO_SMTP_USER is the "Login" value shown on the Brevo
# SMTP & API page — it is NOT the same as the From address.
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER=""
BREVO_SMTP_PASSWORD=""

# From address shown to recipients (must be a verified sender in Brevo).
MAIL_FROM_ADDRESS="paper@k-gpa.or.kr"

# Optional: host paths for persistent volumes.
# Leave unset for local testing (defaults to ./data/pgdata, ./data/uploads).
# On the Synology NAS, set these to your real bind-mount paths, e.g.:
# PGDATA_DIR=/volume1/docker/kgpa_jam/pgdata
# UPLOADS_DIR=/volume1/docker/kgpa_jam/uploads
# BACKUP_DIR=/volume1/docker/kgpa_jam/backups
#PGDATA_DIR=
#UPLOADS_DIR=
#BACKUP_DIR=
